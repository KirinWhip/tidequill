{
  "name": "tidequill",
  "productName": "Tidequill",
  "version": "1.0.0",
  "description": "Tidequill (潮笺) — an independent open-source desktop AI chat client",
  "author": {
    "name": "追逐",
    "email": "KirinWhip@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:main && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --external:electron --target=node20 --metafile=build-meta/main-meta.json",
    "build": "tsc --noEmit && vite build && npm run build:main && node scripts/gen-notices.mjs",
    "start": "electron .",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "pack:linux-dir": "npm run build && electron-builder --linux dir",
    "pack:win-dir": "npm run build && electron-builder --win dir --x64",
    "e2e": "playwright test",
    "notices": "node scripts/gen-notices.mjs"
  },
  "build": {
    "appId": "io.github.kirinwhip.tidequill",
    "productName": "Tidequill",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Tidequill",
      "executableName": "Tidequill"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052",
      "shortcutName": "Tidequill",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "tidequill",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KirinWhip",
        "repo": "tidequill",
        "releaseType": "release"
      }
    ],
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/tray@2x.png",
        "to": "tray@2x.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "copyright": "Copyright © 2026 追逐"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.17",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1",
    "webdav-server": "^2.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KirinWhip/tidequill.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/KirinWhip/tidequill"
}
